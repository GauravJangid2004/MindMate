# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
SANDBOX_MODE=true

# ─── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/MindMate?appName=Cluster0

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_string_64_chars_min
JWT_EXPIRES_IN=7d
PHONE_LOOKUP_SECRET=CHANGE_ME_to_a_separate_random_secret

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Encryption key for diary / chat at rest (32-byte hex) ──
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Google Gemini Flash-Lite LLM (optional generation) ─────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Qwen Embeddings for Mentor Matching ──────────────
# OPTION A: Hugging Face Serverless Inference API (Best for Vercel / Cloud)
# Get a free Hugging Face User Access Token at https://huggingface.co/settings/tokens
QWEN_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/Qwen/Qwen3-Embedding-0.6B/pipeline/feature-extraction
QWEN_EMBEDDING_API_KEY=hf_your_free_hugging_face_token_here
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# OPTION B: Local Ollama (For local dev without API keys)
# QWEN_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
# QWEN_EMBEDDING_API_KEY=
# QWEN_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional Qwen3-Reranker endpoint (e.g. /v1/rerank); leave blank to disable.
QWEN_RERANK_URL=
QWEN_RERANK_API_KEY=
QWEN_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
